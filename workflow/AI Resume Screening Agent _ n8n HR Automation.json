    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI Resume Screening Assistant for HR.\n\nAnalyze the candidate resume against the job requirements.\n\nImportant rules:\n- Do not make final hiring decisions.\n- Do not reject based on age, gender, religion, race, marital status, nationality, or personal background.\n- Only evaluate job-related skills, education, tools, experience, and role fit.\n- If any eligibility detail needs human review, write it in human_review_required.\n\nJOB ROLE:\nArchitectural Engineer\n\nJOB REQUIREMENTS:\n- Bachelor's Degree in Architecture\n- Experience in architectural design\n- Experience in engineering consultancy projects\n- AutoCAD\n- Revit\n- SketchUp\n- Good communication skills\n- Riyadh role location fit\n\nRESUME TEXT:\n{{ $json.text }}\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"candidate_name\": \"\",\n  \"email\": \"\",\n  \"phone\": \"\",\n  \"role_applied\": \"Architectural Engineer\",\n  \"current_location\": \"\",\n  \"current_job_title\": \"\",\n  \"total_experience\": \"\",\n  \"degree\": \"\",\n  \"key_skills\": \"\",\n  \"tools\": \"\",\n  \"matched_requirements\": \"\",\n  \"missing_requirements\": \"\",\n  \"score\": 0,\n  \"recommendation\": \"\",\n  \"reason\": \"\",\n  \"human_review_required\": \"\"\n}\n\nScoring:\n85-100 = Strong match, recommendation Shortlist\n70-84 = Good match, recommendation Shortlist\n50-69 = Partial match, recommendation Maybe\nBelow 50 = Weak match, recommendation Reject\n\nKeep reason short and professional.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        544,
        -96
      ],
      "id": "9796ee5f-1771-45d3-b389-0f25baf9b9e9",
      "name": "AI Resume Screener"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw = $json.text || $json.output || $json.response || $json.result || \"\";\n\n// Agar output object hai to string bana do\nif (typeof raw !== \"string\") {\n  raw = JSON.stringify(raw);\n}\n\nraw = raw.trim();\n\n// Markdown/code block remove\nraw = raw.replace(/^```json/i, \"\");\nraw = raw.replace(/^```/i, \"\");\nraw = raw.replace(/```$/i, \"\");\nraw = raw.trim();\n\n// JSON object extract\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nif (match) {\n  raw = match[0];\n}\n\nlet data;\n\ntry {\n  data = JSON.parse(raw);\n} catch (error) {\n  data = {\n    candidate_name: \"\",\n    email: \"\",\n    phone: \"\",\n    role_applied: \"Architectural Engineer\",\n    current_location: \"\",\n    current_job_title: \"\",\n    total_experience: \"\",\n    degree: \"\",\n    key_skills: \"\",\n    tools: \"\",\n    matched_requirements: \"\",\n    missing_requirements: \"\",\n    score: 0,\n    recommendation: \"Human Review\",\n    reason: \"AI JSON parse nahi hua. Manual review required.\",\n    human_review_required: \"Yes\"\n  };\n}\n\nreturn {\n  json: data\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
